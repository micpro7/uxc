{
  "pkg": {
    "name": "homebridge-arm64",
    "version": "latest",
    "description": "Native ARM64 Homebridge OCI bundle for OpenWrt UXC",
    "arch": "aarch64"
  },
  "oci": {
    "version": "1.0.2",
    "rootfs": "rootfs",
    "process": {
      "terminal": false,
      "user": {
        "uid": 1000,
        "gid": 1000
      },
      "cwd": "/var/lib/homebridge",
      "args": [
        "/sbin/tini",
        "--",
        "/usr/local/bin/homebridge",
        "-U",
        "/var/lib/homebridge"
      ],
      "env": [
        "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
        "NODE_ENV=production",
        "HOME=/var/lib/homebridge",
        "USER=homebridge",
        "TZ=UTC",
        "LANG=C.UTF-8",
        "LC_ALL=C.UTF-8",
        "TERM=xterm-256color",
        "npm_config_update_notifier=false",
        "npm_config_fund=false",
        "npm_config_audit=false"
      ]
    }
  }
}

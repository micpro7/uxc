{
  "ociVersion": "1.0.2",
  "hostname": "hb",
  "process": {
    "terminal": false,
    "user": {
      "uid": 0,
      "gid": 0
    },
    "cwd": "/var/lib/homebridge",
    "capabilities": {
      "bounding": [
        "CAP_NET_RAW",
        "CAP_NET_BIND_SERVICE"
      ],
      "effective": [
        "CAP_NET_RAW",
        "CAP_NET_BIND_SERVICE"
      ],
      "permitted": [
        "CAP_NET_RAW",
        "CAP_NET_BIND_SERVICE"
      ]
    },
    "rlimits": [
      {
        "type": "RLIMIT_NOFILE",
        "hard": 65536,
        "soft": 65536
      }
    ],
    "args": [
      "/sbin/tini",
      "--",
      "/etc/homebridge/start.sh",
      "/usr/local/bin/homebridge",
      "-U",
      "/var/lib/homebridge",
      "-P",
      "/usr/local/lib/node_modules"
    ],
    "env": [
      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
      "LANG=C.UTF-8",
      "LC_ALL=C.UTF-8",
      "TERM=xterm-256color",
      "NODE_ENV=production",
      "HOME=/var/lib/homebridge",
      "NODE_PATH=/usr/local/lib/node_modules",
      "NODE_OPTIONS=--max-old-space-size=384",
      "UV_THREADPOOL_SIZE=4",
      "TZ=Europe/London",
      "MDNS_INTERFACE=br-lan",
      "HOMEBRIDGE_IP=0.0.0.0",
      "HOMEBRIDGE_CONFIG_UI_HOST=0.0.0.0"
    ],
    "noNewPrivileges": false
  },
  "root": {
    "path": "rootfs",
    "readonly": false
  },
  "mounts": [],
  "linux": {
    "namespaces": [
      {
        "type": "pid"
      },
      {
        "type": "mount"
      },
      {
        "type": "ipc"
      },
      {
        "type": "uts"
      }
    ]
  }
}

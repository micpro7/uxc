name: Build Homebridge UXC ARM64 Bundle

on:
  workflow_dispatch:
    inputs:
      homebridge_version:
        description: "Homebridge version"
        required: false
        default: "latest"

      config_ui_version:
        description: "Homebridge Config UI X version"
        required: false
        default: "latest"

  schedule:
    - cron: "0 3 * * 0"


permissions:
  contents: write


jobs:

  build:

    name: Build ARM64 UXC Bundle

    runs-on: ubuntu-24.04-arm


    env:

      ARCH: arm64

      ALPINE_VERSION: "3.22"

      ROOTFS: rootfs

      BUNDLE: bundle

      HOMEBRIDGE_VERSION: ${{ inputs.homebridge_version }}

      CONFIG_UI_VERSION: ${{ inputs.config_ui_version }}



    steps:


    - name: Checkout repository
      uses: actions/checkout@v4



    - name: Install build dependencies
      run: |

        sudo apt update

        sudo apt install -y \
          wget \
          curl \
          tar \
          gzip \
          jq \
          xz-utils \
          rsync



    - name: Create Alpine ARM64 rootfs
      run: |

        mkdir -p $ROOTFS

        wget -q \
          https://dl-cdn.alpinelinux.org/alpine/v${ALPINE_VERSION}/releases/aarch64/alpine-minirootfs-${ALPINE_VERSION}.0-aarch64.tar.gz \
          -O alpine.tar.gz


        tar -xzf alpine.tar.gz \
          -C $ROOTFS



    - name: Prepare Alpine environment
      run: |

        mkdir -p \
          $ROOTFS/etc/apk \
          $ROOTFS/proc \
          $ROOTFS/sys \
          $ROOTFS/dev


        cp /etc/resolv.conf \
          $ROOTFS/etc/resolv.conf



    - name: Install Node and Homebridge
      run: |

        sudo chroot $ROOTFS /bin/sh <<'EOF'

        apk update

        apk add \
          nodejs \
          npm \
          tini \
          ca-certificates \
          bash \
          sudo \
          tzdata


        npm install -g \
          --omit=dev \
          homebridge \
          homebridge-config-ui-x


        mkdir -p /homebridge

        ln -sf /sbin/tini /usr/bin/tini


        EOF



    - name: Create init script
      run: |

        cat > $ROOTFS/init <<'EOF'
#!/bin/sh

exec /sbin/tini -- \
homebridge \
-I \
-U /homebridge
EOF


        chmod +x $ROOTFS/init



    - name: Create OCI bundle
      run: |

        mkdir -p $BUNDLE


        mv $ROOTFS \
          $BUNDLE/rootfs



        cat > $BUNDLE/config.json <<EOF
{
  "ociVersion": "1.0.2",

  "hostname": "homebridge",

  "process": {

    "terminal": true,

    "cwd": "/homebridge",

    "args": [
      "/init"
    ],

    "env": [

      "HOME=/root",

      "PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",

      "NODE_ENV=production",

      "NODE_OPTIONS=--max-old-space-size=256",

      "HOMEBRIDGE_CONFIG_UI=1",

      "HOMEBRIDGE_CONFIG_PATH=/homebridge/config.json",

      "HOMEBRIDGE_CONFIG_UI_HOST=0.0.0.0",

      "HOMEBRIDGE_CONFIG_UI_PORT=8581"

    ],

    "user": {
      "uid":0,
      "gid":0
    }

  },


  "root": {

    "path":"rootfs",

    "readonly":false

  },


  "mounts":[

    {
      "destination":"/proc",
      "type":"proc",
      "source":"proc"
    },

    {
      "destination":"/dev",
      "type":"tmpfs",
      "source":"tmpfs"
    },

    {
      "destination":"/sys",
      "type":"sysfs",
      "source":"sysfs"
    },

    {
      "destination":"/homebridge",
      "type":"bind",
      "source":"/mnt/X6/UXC/homebridge/data",
      "options":[
        "rbind",
        "rw"
      ]
    }

  ],


  "linux": {

    "namespaces":[

      {
        "type":"pid"
      },

      {
        "type":"network"
      },

      {
        "type":"ipc"
      },

      {
        "type":"uts"
      },

      {
        "type":"mount"
      }

    ]

  }

}
EOF



    - name: Validate bundle
      run: |

        jq empty bundle/config.json

        test -f bundle/rootfs/init

        test -d bundle/rootfs/usr



    - name: Package bundle
      run: |

        tar \
          -czf \
          homebridge-arm64.tar.gz \
          bundle



    - name: Create Release
      uses: softprops/action-gh-release@v2

      with:

        tag_name: latest

        name: Homebridge UXC ARM64 Latest

        files: |

          homebridge-arm64.tar.gz